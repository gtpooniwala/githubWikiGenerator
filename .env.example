# Local environment example. Copy this to .env and fill values.
# Do NOT commit your .env file. The repository .gitignore already ignores .env.

# App-level API key used by the frontend to call the backend (not the OpenAI key)
BACKEND_API_KEY=changeme_app_key

# OpenAI API key (backend-only). Fill with your key locally.
OPENAI_API_KEY=changeme_openai_key

# Backend bind port for local run
PORT=8080
